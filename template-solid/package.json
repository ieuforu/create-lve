{
  "name": "solid-app",
  "version": "0.0.0",
  "private": true,
  "description": "Solid 2 component gallery with ui-sdk and Tailwind CSS",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "serve": "vite preview",
    "test": "vitest run",
    "lint": "oxlint --config oxlint.solid.ts --deny-warnings src",
    "fmt": "oxfmt",
    "typecheck": "tsc --noEmit",
    "check": "oxfmt --check && oxlint --config oxlint.solid.ts --deny-warnings src && tsc --noEmit && vitest run",
    "preview": "vite preview",
    "test:watch": "vitest",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "@solidjs/meta": "^2.0.0",
    "@solidjs/router": "^2.0.0",
    "@solidjs/web": "^2.0.0",
    "@ui-sdk/core": "0.1.0-beta.17",
    "@ui-sdk/solid": "0.1.0-beta.17",
    "solid-js": "^2.0.0"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@solidjs/diagnostics": "^2.0.0",
    "@solidjs/testing-library": "^1.0.0-rc.2",
    "@solidjs/vite-plugin": "^3.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.0",
    "eslint-plugin-solid": "~0.20.0",
    "filesystem-routing": "0.5.0",
    "jsdom": "~29.1.1",
    "lucide-static": "^1.81.0",
    "oxfmt": "^0.80.0",
    "oxlint": "~1.92.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "packageManager": "pnpm@12.4.2"
}
