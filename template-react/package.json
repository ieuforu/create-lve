{
  "name": "react-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite",
    "routes:generate": "node scripts/generate-routes.mjs",
    "build": "pnpm typecheck && vite build",
    "typecheck": "pnpm routes:generate && tsc -b --noEmit",
    "typecheck:tsrs": "pnpm routes:generate && tsrs -b --noEmit",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "preview": "vite preview",
    "test": "pnpm routes:generate && vitest run",
    "test:watch": "pnpm routes:generate && vitest",
    "test:coverage": "pnpm routes:generate && vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm typecheck:tsrs && pnpm test"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@tanstack/react-query": "^5.101.3",
    "@tanstack/react-router": "^1.170.17",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "ky": "^2.1.0",
    "lucide-react": "^1.24.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-generator": "1.167.46",
    "@tanstack/router-plugin": "1.168.48",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "oxc-transform-react": "0.156.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.3",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "typescript": "7.1.0-beta",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "packageManager": "pnpm@12.4.2"
}
