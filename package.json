{
  "name": "create-lve",
  "version": "0.6.66",
  "description": "A fast, opinionated frontend project scaffolder for React and Vue.",
  "keywords": [
    "create",
    "react",
    "scaffolding",
    "tailwindcss",
    "typescript",
    "vite",
    "vue"
  ],
  "homepage": "https://github.com/ieuforu/create-lve#readme",
  "bugs": {
    "url": "https://github.com/ieuforu/create-lve/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ieuforu/create-lve.git"
  },
  "bin": {
    "create-lve": "index.js"
  },
  "files": [
    "index.js",
    "config.js",
    "template-react",
    "template-vue",
    "!template-*/coverage",
    "!template-*/dist",
    "!template-*/pnpm-lock.yaml",
    "!template-*/playwright-report",
    "!template-*/test-results",
    "!**/node_modules"
  ],
  "type": "module",
  "scripts": {
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "node --test test/cli.test.js",
    "test:smoke": "node test/smoke.mjs",
    "prepublishOnly": "pnpm fmt:check && pnpm lint",
    "prepare": "husky",
    "check": "pnpm fmt:check && pnpm lint && pnpm test",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major"
  },
  "dependencies": {
    "@clack/prompts": "^1.1.0",
    "fs-extra": "^11.2.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxfmt --write",
      "oxlint --fix"
    ],
    "*.json": "oxfmt --write"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "packageManager": "pnpm@12.4.2"
}
